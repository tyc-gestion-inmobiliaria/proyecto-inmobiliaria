        "label": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.family.sans}",
            "fontSize": "11px",
            "fontWeight": 500,
            "lineHeight": "14px",
            "letterSpacing": "0.8px",
            "textCase": "uppercase"
          }
        },
        "caption": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.family.sans}",
            "fontSize": "12px",
            "fontWeight": 400,
            "lineHeight": "16px",
            "letterSpacing": "0px"
          }
