        "title": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.family.sans}",
            "fontSize": "24px",
            "fontWeight": 600,
            "lineHeight": "30px",
            "letterSpacing": "-0.2px"
          }
        },
        "dialogTitle": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.family.sans}",
            "fontSize": "18px",
            "fontWeight": 600,
            "lineHeight": "24px",
            "letterSpacing": "0px"
          }
