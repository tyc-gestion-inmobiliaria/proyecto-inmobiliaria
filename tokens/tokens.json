      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        },
        "mono": {
          "$type": "fontFamily",
          "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
        }
      },
      "scale": {
        "display": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.family.sans}",
            "fontSize": "32px",
            "fontWeight": 600,
            "lineHeight": "38px",
            "letterSpacing": "-0.4px"
          }
