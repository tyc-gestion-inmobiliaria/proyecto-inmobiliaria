{
  "name": "proyecto-inmobiliaria",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "tokens": "node --import tsx scripts/tokens-a-json.ts",
    "tokens:check": "node --import tsx scripts/tokens-a-json.ts --check",
    "build:web": "expo export --platform web",
    "claves:check": "node scripts/revisar-claves.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "expo": "~57.0.12",
    "expo-asset": "~57.0.20",
    "expo-constants": "~57.0.10",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.5",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.12",
    "expo-sharing": "~57.0.24",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "supabase": "2.121.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  }
}
