# Copiar a .env.local y completar con lo que imprime `supabase start`
# (o con los datos del proyecto de staging). Nunca se commitea .env.local.
#
# Solo van al cliente la URL y la clave pública (anon). Se hornean al
# construir: cambiar de entorno pide construir otra vez.
# La clave de servicio NO va acá: vive en los secretos de las Edge Functions
# y de GitHub.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Maqueta: la app sin servidor, con datos ficticios en memoria, para avanzar
# el diseño. Con `maqueta` no se usa Supabase; vacío o sin la línea, sí.
EXPO_PUBLIC_DATOS=
