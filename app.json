{
  "expo": {
    "name": "proyecto-inmobiliaria",
    "slug": "proyecto-inmobiliaria",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "proyectoinmobiliaria",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Heebo_400.ttf",
              "./assets/fonts/Heebo_500.ttf",
              "./assets/fonts/Heebo_600.ttf",
              "./assets/fonts/Heebo_700.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Heebo",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Heebo_400.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Heebo_500.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Heebo_600.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Heebo_700.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
